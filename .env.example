# TEMP_STOCK_SOURCE=JFC01
# Optional. When set, prebuild and server fetches refresh the temporary menu
# from Apps Script (?store=JFC01). When unset, app/lib/flowers.json and
# app/lib/items.json (mirrored snapshot) are used.
APPS_SCRIPT_URL=

# Cigarette and tobacco listings, banners, nav, sitemap entries, and TV rows.
# Unset, empty, or anything other than true/1/yes/on keeps them hidden.
# Set to true and rebuild to restore the previous cigarette surfaces.
# NEXT_PUBLIC_SHOW_CIGARETTES=false

# Fleet sheet content. Unset uses the public JWC01 blob manifest.
# FLEET_CONTENT_MANIFEST_URL=https://dhaah0upvlpukv56.public.blob.vercel-storage.com/JWC01/manifest.json
# FLEET_REVALIDATE_SECRET is set in the host, never committed.
# Edge Config item contentMode=coded forces coded pages and makes /articles 404.
